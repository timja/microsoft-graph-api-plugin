{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jenkinsci/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Kiota CLI used to generate the Graph client",
      "managerFilePatterns": ["/(^|/)pom\\.xml$/"],
      "matchStrings": ["<kiota\\.cli\\.version>(?<currentValue>[^<]+)</kiota\\.cli\\.version>"],
      "depNameTemplate": "microsoft/kiota",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
